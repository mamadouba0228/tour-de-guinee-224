DirectoryIndex index.html
AddType application/manifest+json .webmanifest

# Fichiers qui ne doivent jamais être lisibles depuis un navigateur
<FilesMatch "^(config\.php|LISEZMOI\.txt)$|\.(sqlite|sqlite-wal|sqlite-shm)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "DENY"
  # Toujours vérifier s'il existe une nouvelle version de l'application
  <FilesMatch "\.(html|webmanifest)$|^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
